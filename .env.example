# Справочник настроек. npm run setup создаст .env с безопасным случайным паролем.
# Локальная разработка. npm run setup не перезаписывает существующий .env.
HOST=127.0.0.1
PORT=3001
ADMIN_PASSWORD=
# Необязательно: PostgreSQL вместо SQLite. Настоящую строку храните только
# в игнорируемом .env или в Environment на Render. Не используйте VITE_ для секрета.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Путь к SQLite используется только без DATABASE_URL.
# DB_PATH=data/semka.sqlite

# На Render задайте в Environment, а не в публичном файле:
# NODE_ENV=production
# NODE_VERSION=24
# HOST=0.0.0.0
# DATABASE_URL=<строка подключения Neon из Connect>
# ADMIN_PASSWORD=<отдельный случайный пароль от 12 до 256 символов>
# Blueprint создаёт ADMIN_PASSWORD автоматически; смотреть в Render Environment.
# Для стандартного onrender.com origin берётся из RENDER_EXTERNAL_URL автоматически.
# Для собственного домена или другого хостинга:
# ALLOWED_ORIGIN=https://example.com
# PORT предоставляет Render; копировать локальный PORT=3001 не требуется.
# NODE_ENV=production включает Secure для cookie. Отдельный SECURE_COOKIE не нужен.
